{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // ADR-005: coty.design on Workers + Static Assets, account "Personal Site (coty.design)".
  "name": "coty-design",
  "account_id": "0ed988062db16e9b295dfa620f6c29eb",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    // Worker handles pages, agent detection and machine-readable routes;
    // hashed bundles and fonts go straight to the asset layer (free, unmetered).
    "run_worker_first": ["/*", "!/assets/*", "!/fonts/*"]
  },
  "rules": [
    { "type": "Text", "globs": ["**/*.jsonld", "**/*.html"], "fallthrough": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "coty-design-analytics",
      "database_id": "5da5cea4-18fd-4246-b88a-cc8af894f8c4",
      "migrations_dir": "migrations"
    }
  ]
}
