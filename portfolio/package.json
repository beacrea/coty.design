{
  "name": "coty-design-clone",
  "private": true,
  "version": "5.0.1",
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "dev:vite": "vite --host 0.0.0.0 --port 5001",
    "build": "vite build",
    "build:worker": "vite build && cp worker/_headers dist/_headers",
    "dev:worker": "npm run build:worker && wrangler d1 migrations apply DB --local && wrangler dev",
    "deploy:worker": "npm run build:worker && wrangler deploy",
    "typecheck:worker": "tsc -p worker",
    "test:doctrine-seo": "tsx --test server/lib/og-meta.test.ts",
    "start": "NODE_ENV=production tsx server/index.ts",
    "preview": "vite preview",
    "migrate-sqlite-to-pg": "tsx scripts/migrate-sqlite-to-pg.ts",
    "validate-corpus": "tsx scripts/validate-corpus.ts",
    "validate-agent": "tsx scripts/validate-agent.ts",
    "lighthouse:local": "lighthouse http://localhost:5000 --chrome-flags='--headless --no-sandbox --disable-gpu' --output=json --output=html --output-path=./lighthouse-report --quiet",
    "lighthouse:prod": "lighthouse https://coty.design --chrome-flags='--headless --no-sandbox --disable-gpu' --output=json --output=html --output-path=./lighthouse-report --quiet"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tsconfig/svelte": "^5.0.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.15.4",
    "better-sqlite3": "^12.8.0",
    "lighthouse": "^13.6.0",
    "svelte": "^5.57.3",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5",
    "vite": "^7.3.7",
    "wrangler": "^4.158.0"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "express": "^5.2.2",
    "isbot": "^5.1.36",
    "pg": "^8.20.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
